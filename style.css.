:root {
  --preto-1: #0a0a0f;
  --preto-2: #111118;
  --preto-3: #1a1a22;
  --dourado: #D4AF37;
  --dourado-claro: #f5d76e;
  --cinza: #bfbfbf;
  --branco: #ffffff;
}

/* RESET */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

/* FUNDO COM PROFUNDIDADE */
body {
  font-family: 'Poppins', sans-serif;
  background: radial-gradient(circle at top, #1a1a22, #0a0a0f);
  color: var(--branco);
}

/* HEADER */
header {
  background: linear-gradient(90deg, var(--preto-2), var(--preto-3));
  padding: 20px;
  text-align: center;
  border-bottom: 1px solid rgba(212,175,55,0.2);
}

header h1 {
  letter-spacing: 1px;
}

/* MENU */
nav ul {
  display: flex;
  justify-content: center;
  gap: 20px;
  list-style: none;
  margin-top: 10px;
}

nav a {
  color: var(--branco);
  text-decoration: none;
  position: relative;
  transition: 0.3s;
}

nav a:hover {
  color: var(--dourado-claro);
}

nav a::after {
  content: "";
  width: 0;
  height: 2px;
  background: linear-gradient(90deg, transparent, var(--dourado), transparent);
  position: absolute;
  bottom: -4px;
  left: 0;
  transition: 0.4s;
}

nav a:hover::after {
  width: 100%;
}

/* SEÇÕES */
section {
  padding: 70px 20px;
  text-align: center;
}

/* ANIMAÇÃO */
.fade {
  opacity: 0;
  transform: translateY(25px);
  transition: 0.7s ease;
}

.fade.show {
  opacity: 1;
  transform: translateY(0);
}

/* SOBRE */
#sobre img {
  width: 180px;
  height: 180px;
  border-radius: 50%;
  object-fit: cover;
  margin: 25px 0;

  border: 3px solid var(--dourado);
  
  /* EFEITO DE LUZ */
  box-shadow:
    0 0 15px rgba(212,175,55,0.3),
    0 0 40px rgba(212,175,55,0.1);
}

#sobre p {
  max-width: 600px;
  margin: auto;
  color: var(--cinza);
  line-height: 1.6;
}

/* PROJETOS */
#projetos {
  background: linear-gradient(180deg, var(--preto-2), var(--preto-1));
}

#lista-projetos {
  display: flex;
  flex-direction: column;
  gap: 25px;
  margin-top: 30px;
}

/* CARDS */
article {
  background: linear-gradient(145deg, #1a1a22, #111118);
  padding: 25px;
  border-radius: 12px;

  border: 1px solid rgba(212,175,55,0.1);

  transition: 0.3s;
}

article:hover {
  transform: translateY(-8px) scale(1.02);

  /* GLOW */
  box-shadow:
    0 10px 30px rgba(0,0,0,0.5),
    0 0 15px rgba(212,175,55,0.2);
}

article h3 {
  margin-bottom: 10px;
}

article p {
  color: var(--cinza);
}

article a {
  display: inline-block;
  margin-top: 12px;
  color: var(--dourado);
  font-weight: bold;
  text-decoration: none;
}

article a:hover {
  color: var(--dourado-claro);
}

/* CONTATO */
.info-contato {
  background: linear-gradient(145deg, #1a1a22, #111118);
  padding: 20px;
  border-radius: 12px;
  max-width: 400px;
  margin: auto;

  border: 1px solid rgba(212,175,55,0.1);

  box-shadow: 0 0 10px rgba(0,0,0,0.3);
}

.info-contato p {
  margin: 10px 0;
}

/* FOOTER */
footer {
  background: var(--preto-2);
  padding: 15px;
  text-align: center;
  border-top: 1px solid rgba(212,175,55,0.2);
}

/* RESPONSIVO */
@media (min-width: 768px) {
  #lista-projetos {
    flex-direction: row;
    justify-content: center;
  }

  article {
    width: 300px;
  }
}
